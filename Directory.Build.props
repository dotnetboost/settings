<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-recommended</AnalysisLevel>

    <!--
      Single source of truth for the version every package ships under. CI overrides it with
      -p:PackageVersion=… derived from the git tag, so this is what a local build produces and
      the floor a release is cut from. Bump it here, not in the individual projects.
    -->
    <Version>1.0.0</Version>

    <Authors>DotNetBoost Contributors</Authors>
    <Company>DotNetBoost</Company>
    <!-- A range, not just the current year: 2025 is when the work was first published and that
         claim stands. Deliberately a literal — deriving it from the build date would make the
         package contents vary by build day and defeat <Deterministic>. -->
    <Copyright>© 2025-2026 DotNetBoost Contributors</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/dotnetboost/settings</PackageProjectUrl>
    <RepositoryUrl>https://github.com/dotnetboost/settings</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>settings;configuration;dotnet;aspnetcore;efcore;dapper;mongodb</PackageTags>

    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>

    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub"/>
  </ItemGroup>
</Project>
