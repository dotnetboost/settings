<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>DotNetBoost.Settings.Core</PackageId>
    <Description>
      Core abstractions and engine for DotNetBoost.Settings — a strongly-typed,
      database-backed runtime settings manager for ASP.NET Core.
      Includes ISettingManager, ISettingStore, ISettingCache, change notifications,
      audit trail, and encryption support.
    </Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- Extensions and the conversion helpers are internal engine details; the unit tests
         cover them directly rather than only through the public surface. -->
    <InternalsVisibleTo Include="DotNetBoost.Settings.UnitTests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>
</Project>
