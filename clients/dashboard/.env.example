# Only needed when the dashboard and the API are started separately. Under the Aspire
# AppHost (aspire/DotNetBoost.Settings.AppHost) both values are injected automatically,
# pointing at whichever ports Aspire allocated.

# Base address of the DotNetBoost.Settings API the dashboard reads and writes.
# Used server-side by the /api/settings/** proxy.
NUXT_SETTINGS_API_URL=http://localhost:5199

# Where the sidebar's "API reference" link points.
NUXT_PUBLIC_API_REFERENCE_URL=http://localhost:5199/scalar
